# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/task_management_system

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Email (Nodemailer - using Gmail SMTP as example)
# For Gmail: enable 2FA on the account, then create an "App Password"
# https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="Task Manager <your_email@gmail.com>"

# Default admin created by the seed script (npm run seed)
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@taskmanager.com
ADMIN_PASSWORD=Admin@123

# Frontend URL (used for CORS)
CLIENT_URL=http://localhost:5173
